# Site
# The canonical base URL of the deployed site. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://shraavanitople.github.io/agora

# Analytics (pick one, leave others blank)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Error tracking
# SENTRY_DSN=https://xxxxxxxx@oxxxxxxxx.ingest.sentry.io/xxxxxxxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=agora-marketing

# Forms (add your backend endpoint once the API is built)
# NEXT_PUBLIC_FORM_ENDPOINT=https://api.yourdomain.com/contact
